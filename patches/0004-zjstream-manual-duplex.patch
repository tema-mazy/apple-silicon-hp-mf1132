+static DRIVER_ERROR writeManualDuplexPage(cups_raster_t *out_raster, int fdPages, cups_page_header2_t *header,
+                                          off_t offset, bool rotate, bool blank)
+{
+    unsigned int        bpl = header->cupsBytesPerLine;
+    unsigned int        bits = header->cupsBitsPerPixel;
+    unsigned int        unit = bits / 8;
+    std::vector<BYTE>   line(bpl);
+    std::vector<BYTE>   flip(bpl);
+
+    cupsRasterWriteHeader2(out_raster, header);
+    for (unsigned int y = 0; y < header->cupsHeight; y++)
+    {
+        if (blank)
+        {
+            memset(&line[0], (header->cupsColorSpace == CUPS_CSPACE_K) ? 0x00 : 0xFF, bpl);
+        }
+        else
+        {
+            unsigned int row = rotate ? header->cupsHeight - 1 - y : y;
+            if (pread(fdPages, &line[0], bpl, offset + (off_t) row * bpl) != (ssize_t) bpl)
+            {
+                return SYSTEM_ERROR;
+            }
+            if (rotate && bits % 8)
+            {
+                // Sub-byte pixels (1, 2 or 4 bits): mirror pixel by pixel
+                unsigned int w = header->cupsWidth, mask = (1 << bits) - 1;
+                memset(&flip[0], 0, bpl);
+                for (unsigned int x = 0; x < w; x++)
+                {
+                    unsigned int s = x * bits, d = (w - 1 - x) * bits;
+                    unsigned int v = (line[s >> 3] >> (8 - bits - (s & 7))) & mask;
+                    flip[d >> 3] |= v << (8 - bits - (d & 7));
+                }
+                line.swap(flip);
+            }
+            else if (rotate)
+            {
+                for (unsigned int a = 0, b = bpl - unit; a < b; a += unit, b -= unit)
+                {
+                    for (unsigned int k = 0; k < unit; k++)
+                    {
+                        BYTE t = line[a + k];
+                        line[a + k] = line[b + k];
+                        line[b + k] = t;
+                    }
+                }
+            }
+        }
+        cupsRasterWritePixels(out_raster, &line[0], bpl);
+    }
+    return NO_ERROR;
+}
+
+/*
+ * Manual duplex for printers without a duplex unit, same page order as foo2zjs:
+ * front sides in order, then (after the ZJT_PAUSE sent by StartPage) the back
+ * sides in reverse order, rotated 180 degrees for long edge binding. An odd
+ * page count gets a blank back side for the last sheet.
+ */
+DRIVER_ERROR LJZjStream::preProcessManualDuplex(cups_raster_t **ppcups_raster, cups_page_header2_t* firstpage_cups_header, char* pSwapedPagesFileName)
+{
+    DRIVER_ERROR                        err = NO_ERROR;
+    std::vector<cups_page_header2_t>    headers;
+    std::vector<off_t>                  offsets;
+    std::vector<BYTE>                   line;
+    cups_page_header2_t                 cups_header;
+    cups_raster_t                       *out_raster = NULL;
+    bool                                rotate = (m_pJA->manual_duplex == DUPLEXMODE_BOOK);
+    char                                szPagesFile[MAX_FILE_PATH_LEN];
+    off_t                               pos = 0;
+    int                                 fdPages, fdOut, n, p;
 
+    snprintf(szPagesFile, sizeof(szPagesFile), "%s/hp_%s_cups_PagesXXXXXX", CUPS_TMP_DIR, m_pJA->user_name);
+    fdPages = mkstemp(szPagesFile);
+    fdOut = mkstemp(pSwapedPagesFileName);
+    unlink(szPagesFile);
+    if (fdPages < 0 || fdOut < 0)
+    {
+        dbglog("ERROR: Unable to open temp files for manual duplex\n");
+        err = SYSTEM_ERROR;
+        goto bugout;
+    }
+
+    // Spool every page, remembering where each one starts
+    memcpy(&cups_header, firstpage_cups_header, sizeof(cups_page_header2_t));
+    do
+    {
+        headers.push_back(cups_header);
+        offsets.push_back(pos);
+        line.resize(cups_header.cupsBytesPerLine);
+        for (unsigned int y = 0; y < cups_header.cupsHeight; y++)
+        {
+            cupsRasterReadPixels(*ppcups_raster, &line[0], cups_header.cupsBytesPerLine);
+            if (write(fdPages, &line[0], cups_header.cupsBytesPerLine) != (ssize_t) cups_header.cupsBytesPerLine)
+            {
+                err = SYSTEM_ERROR;
+                goto bugout;
+            }
+            pos += cups_header.cupsBytesPerLine;
+        }
+    } while (cupsRasterReadHeader2(*ppcups_raster, &cups_header));
+
+    n = (int) headers.size();
+    out_raster = cupsRasterOpen(fdOut, CUPS_RASTER_WRITE);
+    if (out_raster == NULL)
+    {
+        err = NULL_POINTER;
+        goto bugout;
+    }
+
+    for (p = 0; p < n && err == NO_ERROR; p += 2)
+    {
+        err = writeManualDuplexPage(out_raster, fdPages, &headers[p], offsets[p], false, false);
+    }
+    if (n > 1)
+    {
+        if (n % 2 && err == NO_ERROR)
+        {
+            err = writeManualDuplexPage(out_raster, fdPages, &headers[n - 1], 0, false, true);
+        }
+        for (p = (n % 2) ? n - 2 : n - 1; p >= 1 && err == NO_ERROR; p -= 2)
+        {
+            err = writeManualDuplexPage(out_raster, fdPages, &headers[p], offsets[p], rotate, false);
+        }
+        m_iManualDuplexPause = (n + 1) / 2;
+    }
+    cupsRasterClose(out_raster);
+    close(fdOut);
+    close(fdPages);
+    if (err != NO_ERROR)
+    {
+        return err;
+    }
+    dbglog("DEBUG: manual duplex: %d pages, pause after %d\n", n, m_iManualDuplexPause);
+
+    if ((fdOut = open(pSwapedPagesFileName, O_RDONLY)) == -1)
+    {
+        return SYSTEM_ERROR;
+    }
+    *ppcups_raster = cupsRasterOpen(fdOut, CUPS_RASTER_READ);
+    if (*ppcups_raster == NULL || !cupsRasterReadHeader2(*ppcups_raster, firstpage_cups_header))
+    {
+        return SYSTEM_ERROR;
+    }
+    return NO_ERROR;
+
+bugout:
+    if (fdPages >= 0)
+        close(fdPages);
+    if (fdOut >= 0)
+        close(fdOut);
+    return err;
+}
