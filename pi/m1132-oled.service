[Unit]
Description=M1132 status on the SSD1306 OLED
After=cups.service m1132-escl.service network.target
ConditionPathExists=/dev/i2c-1

[Service]
ExecStart=/usr/local/bin/m1132-oled
Restart=always
RestartSec=10
DynamicUser=yes
SupplementaryGroups=i2c
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
